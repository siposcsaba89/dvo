{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2026",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "toolchainFile": "E:/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "linux-clang",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/linux",
      "toolchainFile": "$env{HOME}/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic",
        "CMAKE_CXX_COMPILER": "clang++-21",
        "CMAKE_CONFIGURATION_TYPES": "Release;Debug"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "vs2026", "configuration": "Release" },
    { "name": "debug", "configurePreset": "vs2026", "configuration": "Debug" },
    { "name": "linux-release", "configurePreset": "linux-clang", "configuration": "Release" },
    { "name": "linux-debug", "configurePreset": "linux-clang", "configuration": "Debug" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "vs2026", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "linux-release", "configurePreset": "linux-clang", "configuration": "Release", "output": { "outputOnFailure": true } }
  ]
}
